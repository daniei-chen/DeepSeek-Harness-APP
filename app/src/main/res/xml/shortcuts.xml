<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: long-press launcher shortcut. The app has one surface (the WebView shell), so this
     shortcut is the ordinary launcher intent. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="open"
        android:shortcutLongLabel="@string/shortcut_open_long"
        android:shortcutShortLabel="@string/shortcut_open_short">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.labteto.dshmobile.webshell.WebShellActivity"
            android:targetPackage="com.labteto.dshmobile.kaogong" />
    </shortcut>
</shortcuts>
